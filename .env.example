# WattStream settings
# 1. Copy this file to .env:   Copy-Item .env.example .env
# 2. Put your real values in .env, never in this file.
# .env is git-ignored, so your keys stay on your laptop.

# ---- Kafka cluster ----
# Cluster > Overview tab > Bootstrap server
# e.g. pkc-a1b2c.us-east-1.aws.confluent.cloud:9092
BOOTSTRAP_SERVERS=
# API key + secret with resource scope "Kafka cluster"
KAFKA_API_KEY=
KAFKA_API_SECRET=

# ---- Schema Registry ----
# Environment > Stream Governance > Schema Registry > Endpoints tab > Public endpoint
# e.g. https://psrc-a1b2c.us-east-1.aws.confluent.cloud
SCHEMA_REGISTRY_URL=
# A separate API key + secret with resource scope "Schema Registry"
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

# ---- Topics (defaults; change only if you use other names) ----
READINGS_TOPIC=meter-readings
ALERTS_TOPIC=overload-alerts
